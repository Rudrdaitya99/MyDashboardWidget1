<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp" android:background="@drawable/glass_card">
    <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/ring_outline">
        <TextView android:id="@+id/batteryPercentText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="52%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
        <TextView android:id="@+id/batteryLabelText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BATTERY" android:textColor="#BDBDBD" android:textSize="8sp" android:textStyle="bold"/>
        <TextView android:id="@+id/batteryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery · 52%" android:textColor="#FFFFFF" android:textSize="1sp" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="remaining" android:textColor="#D0D0D0" android:textSize="9sp"/>
    </LinearLayout>
</LinearLayout>