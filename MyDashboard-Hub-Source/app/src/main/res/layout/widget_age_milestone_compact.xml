<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp" android:background="@drawable/glass_card">
    <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/ring_outline">
        <TextView android:id="@+id/ageNumberText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="5145" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
        <TextView android:id="@+id/ageLabelText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DAYS ALIVE" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold"/>
        <TextView android:id="@+id/ageText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text="Age · 5145 days"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="personal counter" android:textColor="#BDBDBD" android:textSize="8sp"/>
    </LinearLayout>
</LinearLayout>