<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/glass_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DASHBOARD / MONO" android:textColor="#B8B8B8" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.12"/>
    <TextView android:id="@+id/timeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="12:45" android:textColor="#FFFFFF" android:textSize="32sp" android:layout_marginTop="2dp"/>
    <TextView android:id="@+id/dateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TUE · 20 OCT" android:textColor="#B8B8B8" android:textSize="11sp"/>
    <TextView android:id="@+id/batteryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery · 52%" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="5dp" android:background="@drawable/glass_button" android:padding="5dp"/>
    <TextView android:id="@+id/weatherText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Weather · later update" android:textColor="#B8B8B8" android:textSize="11sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/ageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Age · set birthday in app" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/countdownText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Countdown · set target" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/chatgptText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✳ ChatGPT" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/geminiText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦ Gemini" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="4dp"/>
</LinearLayout>