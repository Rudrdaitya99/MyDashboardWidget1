<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/glass_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI FOLDER"
        android:textColor="#B8B8B8" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/chatgptText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✳ ChatGPT" android:textColor="#FFFFFF" android:textSize="15sp" android:singleLine="true"
        android:ellipsize="end" android:layout_marginTop="4dp" android:background="@drawable/glass_button" android:padding="4dp"/>
    <TextView android:id="@+id/geminiText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ Gemini" android:textColor="#FFFFFF" android:textSize="15sp" android:singleLine="true"
        android:ellipsize="end" android:layout_marginTop="4dp" android:background="@drawable/glass_button" android:padding="4dp"/>
</LinearLayout>
