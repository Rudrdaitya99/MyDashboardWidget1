<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp"
    android:background="@drawable/glass_mountain_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▰"
        android:textColor="#FFFFFF" android:textSize="18sp" android:paddingEnd="5dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BATTERY"
            android:textColor="#D0D0D0" android:textSize="8sp" android:textStyle="bold"/>
        <TextView android:id="@+id/batteryText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Battery · 52%" android:textColor="#FFFFFF" android:textSize="14sp"
            android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>