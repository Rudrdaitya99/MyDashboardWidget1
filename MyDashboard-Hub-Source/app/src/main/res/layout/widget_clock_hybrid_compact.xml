<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/mountainBackground" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:contentDescription="Snow Ridge mountain background"/>
    <LinearLayout android:id="@+id/widgetRoot" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/glass_mountain_overlay">
        <AnalogClock android:id="@+id/analogClock" android:layout_width="36dp"
            android:layout_height="36dp" android:dial="@drawable/clock_dial"
            android:hand_hour="@drawable/clock_hand_hour" android:hand_minute="@drawable/clock_hand_minute"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/timeText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="09:41" android:textColor="#FFFFFF"
                android:textSize="18sp" android:singleLine="true"/>
            <TextView android:id="@+id/dateText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="TUE · 20 OCT"
                android:textColor="#F0FFFFFF" android:textSize="9sp" android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
