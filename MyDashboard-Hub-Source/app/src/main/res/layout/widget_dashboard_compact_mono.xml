<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="7dp" android:background="@drawable/glass_mountain_card">
    <TextView android:id="@+id/timeText" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="12:45" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="27sp" android:paddingHorizontal="5dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/dateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TUE · 20 OCT" android:textColor="#FFFFFF" android:textSize="11sp" android:singleLine="true"/>
        <TextView android:id="@+id/batteryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery · 52%" android:textColor="#B8B8B8" android:textSize="11sp" android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>