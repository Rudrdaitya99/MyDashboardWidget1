<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="13dp" android:background="@drawable/widget_glass">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MY DASHBOARD" android:textColor="#C4FFE0" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15"/>
 <TextClock android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="40sp" android:fontFamily="sans-serif-light"/>
 <TextClock android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textColor="#D4D9E3" android:textSize="12sp"/>
 <TextView android:id="@+id/widget_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="BATTERY --" android:textColor="#C4FFE0" android:textSize="12sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Weather loading" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
 <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="No countdown set" android:textColor="#C4FFE0" android:textSize="11sp" android:maxLines="1"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="QUICK ACCESS" android:textColor="#D4D9E3" android:textSize="9sp" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/button_shortcut1" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:minWidth="0dp" android:padding="1dp" android:text="App 1" android:textAllCaps="false" android:textSize="9sp"/>
  <Button android:id="@+id/button_shortcut2" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:padding="1dp" android:text="App 2" android:textAllCaps="false" android:textSize="9sp"/>
  <Button android:id="@+id/button_shortcut3" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:padding="1dp" android:text="App 3" android:textAllCaps="false" android:textSize="9sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/button_settings" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:minWidth="0dp" android:text="Settings" android:textAllCaps="false" android:textSize="9sp"/>
  <Button android:id="@+id/button_camera" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:text="Camera" android:textAllCaps="false" android:textSize="9sp"/>
  <Button android:id="@+id/button_music" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:text="Music" android:textAllCaps="false" android:textSize="9sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/button_previous" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:minWidth="0dp" android:text="|◀" android:textSize="11sp"/>
  <Button android:id="@+id/button_play_pause" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:text="Play/Pause" android:textAllCaps="false" android:textSize="9sp"/>
  <Button android:id="@+id/button_next" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="3dp" android:minWidth="0dp" android:text="▶|" android:textSize="11sp"/>
 </LinearLayout>
</LinearLayout>
